# ===========================================================================
# El captcha se resuelve con IA (Gemini/OpenAI) y, si falla, manualmente.
# Copia este archivo como ".env" y configura al menos GEMINI_API_KEY.
# El archivo .env NO se comparte ni se sube al repositorio.
# ===========================================================================

MANUAL_TIMEOUT=240
CAPTCHA_MAX_ATTEMPTS=5
CAPTCHA_AI_ATTEMPTS=3
CAPTCHA_MODE=auto
DOWNLOAD_TIMEOUT=30
DRIVER_BACKEND=selenium

# Claves de IA para el captcha (no las compartas)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4o-mini
# CAPTCHA_PROVIDERS=gemini:gemini-2.5-flash,openai:gpt-4o-mini
GENERATE_REPORTS=1

# Nombre que aparece en el informe PPTX
EMPRESA_INFORME=Mi empresa
